          "type": "string",
          "pattern": "^[A-Za-z]+[-:][A-Za-z0-9._:\\-]+$"
         }
        },
        "description": {
         "type": "string"
        },
        "relative_only": {
         "type": "boolean"
        }
       },
       "required": [
        "label",
        "unit",
        "provenance",
        "source_ids",
        "description"
       ],
       "additionalProperties": false
      },
      "diffuse_wm2": {
       "type": "object",
       "properties": {
        "label": {
         "type": "string"
        },
        "unit": {
         "type": "string"
        },
        "provenance": {
         "enum": [
          "measured",
          "derived",
          "modeled",
          "synthetic",
          "assumed_parameter"
         ]
        },
        "source_ids": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^[A-Za-z]+[-:][A-Za-z0-9._:\\-]+$"
         }
        },
        "description": {
         "type": "string"
        },
        "relative_only": {
         "type": "boolean"
        }
       },
       "required": [
        "label",
        "unit",
        "provenance",
        "source_ids",
        "description"
       ],
       "additionalProperties": false
      },
      "beam_horizontal_wm2": {
       "type": "object",
       "properties": {
        "label": {
         "type": "string"
        },
        "unit": {
         "type": "string"
        },
        "provenance": {
         "enum": [
          "measured",
          "derived",
          "modeled",
          "synthetic",
          "assumed_parameter"
         ]
        },
        "source_ids": {
         "type": "array",
         "items": {
          "type": "string",
          "pattern": "^[A-Za-z]+[-:][A-Za-z0-9._:\\-]+$"
         }
        },
        "description": {
         "type": "string"
        },
        "relative_only": {
         "type": "boolean"
        }
       },
       "required": [
        "label",
        "unit",
        "provenance",
        "source_ids",
        "description"
       ],
       "additionalProperties": false
