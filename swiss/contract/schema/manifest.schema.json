       ],
       "additionalProperties": false
      }
     },
     "required": [
      "temp_c",
      "ghi_wm2",
      "diffuse_wm2",
      "beam_horizontal_wm2",
      "price_chf_kwh",
      "tariff_tier",
      "carbon_relative_rank"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "building",
    "district",
    "conditions"
   ],
   "additionalProperties": false
  },
  "situation_tags": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "situation_thresholds": {
   "type": "object",
   "properties": {
    "cold_temp_c": {
     "type": "number"
    },
    "tank_full_soc": {
     "type": "number"
    },
    "tank_empty_soc": {
     "type": "number"
    },
    "flow_epsilon_kwh_th": {
     "type": "number"
    },
    "near_capacity_fraction": {
