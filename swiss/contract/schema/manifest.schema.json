         }
        },
        "description": {
         "type": "string"
        },
        "relative_only": {
         "type": "boolean"
        }
       },
       "required": [
        "label",
        "unit",
        "provenance",
        "source_ids",
        "description"
       ],
       "additionalProperties": false
      },
      "tariff_tier": {
       "type": "object",
