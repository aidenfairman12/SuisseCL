        "label",
        "unit",
        "provenance",
        "source_ids",
        "description"
       ],
       "additionalProperties": false
      },
      "carbon_relative_rank": {
       "type": "object",
       "properties": {
        "label": {
         "type": "string"
        },
        "unit": {
         "type": "string"
        },
        "provenance": {
         "enum": [
          "measured",
          "derived",
          "modeled",
          "synthetic",
          "assumed_parameter"
         ]
        },
        "source_ids": {
         "type": "array",
