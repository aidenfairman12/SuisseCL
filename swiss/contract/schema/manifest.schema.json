    }
   },
   "required": [
    "cold_temp_c",
    "tank_full_soc",
    "tank_empty_soc",
    "flow_epsilon_kwh_th",
    "near_capacity_fraction",
    "storage_covers_demand_share"
   ],
   "additionalProperties": false
  },
  "units": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "checks": {
   "type": "object"
  },
  "generated": {
   "type": "object",
   "properties": {
    "git_commit": {
     "type": "string"
    },
    "git_dirty": {
     "type": "boolean"
    },
    "python": {
     "type": "string"
    },
    "citylearn": {
     "type": "string"
    }
   },
   "required": [
    "git_commit",
    "git_dirty",
    "python",
    "citylearn"
   ],
   "additionalProperties": false
  },
  "files": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "inputs": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  }
 },
 "required": [
  "contract_version",
  "phase",
  "kind",
  "description",
  "district_note",
  "year",
  "timezone",
  "index_convention",
  "time_axis",
  "buildings",
  "controllers",
  "scenarios",
  "runs",
  "variables",
  "situation_tags",
  "situation_thresholds",
  "units",
  "checks",
  "generated",
  "files",
  "inputs"
 ],
 "additionalProperties": false
}
