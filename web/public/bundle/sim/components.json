{"contract_version":"1.0.0","components":[{"id":"grid","label":"Electricity grid","category":"grid","description":"The only electricity source in Phase A. Everything the buildings use is bought from the grid; there is no PV, battery or local sharing.","phase_available":"A","status":"modeled","variables":["net_kwh_el"],"provenance":"modeled","source_ids":["D-018"],"present_in":"all six buildings","docs":[],"inputs":[],"outputs":["grid_hp_sh","grid_hp_hw","grid_household","grid_outcomes"]},{"id":"weather","label":"Weather","category":"input","description":"Outdoor temperature (and irradiance, not used by any Phase A device). An input, not an energy source.","phase_available":"A","status":"modeled","variables":["temp_c"],"provenance":"measured","source_ids":["SRC-004","DER-007"],"present_in":"all six buildings","docs":[],"inputs":[],"outputs":["weather_hp_sh","weather_hp_hw"]},{"id":"tariff","label":"Electricity tariff","category":"input","description":"Two-tier EKZ standard tariff 2023 (excl. VAT). An input that prices grid electricity.","phase_available":"A","status":"modeled","variables":["price_chf_kwh","tariff_tier"],"provenance":"measured","source_ids":["DER-008","D-012"],"present_in":"all six buildings","docs":[],"inputs":[],"outputs":["tariff_controller","tariff_outcomes"]},{"id":"carbon","label":"Grid carbon intensity","category":"input","description":"Modeled series; only the relative rank of an hour is exported. Used for relative emission comparisons, not for control.","phase_available":"A","status":"modeled","variables":["carbon_relative_rank"],"provenance":"modeled","source_ids":["DER-011","M-002","D-013b","ISS-033"],"present_in":"all six buildings","docs":[],"inputs":[],"outputs":["carbon_outcomes"]},{"id":"controller","label":"Controller","category":"control","description":"Decides when each tank charges or discharges. It cannot switch the heat pump or change the demand.","phase_available":"A","status":"modeled","variables":["sh_tank_action","hw_tank_action","sh_tank_mode","hw_tank_mode"],"provenance":"modeled","source_ids":["ALG-001","ALG-003","ALG-004"],"present_in":"all six buildings","docs":[],"inputs":["tariff_controller"],"outputs":["controller_tank_sh","controller_tank_hw"]},{"id":"hp_sh","label":"Heat pump (space heating)","category":"conversion","description":"Turns electricity into heat; the COP falls as it gets colder outside. Modeled with a Carnot-fraction COP (M-001).","phase_available":"A","status":"modeled","variables":["hp_sh_kwh_el","hp_sh_direct_kwh_th","hp_sh_to_tank_kwh_th","cop_sh"],"provenance":"modeled","source_ids":["M-001","D-014d"],"present_in":"all six buildings","docs":[],"inputs":["grid_hp_sh","weather_hp_sh"],"outputs":["hp_sh_demand","hp_sh_tank"]},{"id":"hp_hw","label":"Heat pump (hot water and other base load)","category":"conversion","description":"Second heat-pump device for the warm-weather base load (hot water and other use, A-005).","phase_available":"A","status":"modeled","variables":["hp_hw_kwh_el","hp_hw_direct_kwh_th","hp_hw_to_tank_kwh_th","cop_hw"],"provenance":"modeled","source_ids":["M-001","A-005","D-014e"],"present_in":"all six buildings","docs":[],"inputs":["grid_hp_hw","weather_hp_hw"],"outputs":["hp_hw_demand","hp_hw_tank"]},{"id":"tank_sh","label":"Heating tank","category":"storage","description":"Synthetic buffer tank (assumed size, efficiency and loss rate); the controller charges and discharges it.","phase_available":"A","status":"modeled","variables":["sh_tank_soc","sh_tank_loss_kwh_th"],"provenance":"assumed_parameter","source_ids":["D-017a","ISS-029","ISS-032"],"present_in":"all six buildings","docs":[],"inputs":["hp_sh_tank","controller_tank_sh"],"outputs":["tank_sh_demand"]},{"id":"tank_hw","label":"Hot-water / base-load tank","category":"storage","description":"Synthetic tank, only where the heat pump serves a base load of at least 3 kWh_th per day (D-017a).","phase_available":"A","status":"modeled","variables":["hw_tank_soc","hw_tank_loss_kwh_th"],"provenance":"assumed_parameter","source_ids":["D-017a","ISS-029","ISS-032"],"present_in":"five buildings (not SFH-low)","docs":[],"inputs":["hp_hw_tank","controller_tank_hw"],"outputs":["tank_hw_demand"]},{"id":"demand_sh","label":"Space-heating demand","category":"demand","description":"Derived heat demand; always met. Indoor temperature and comfort are not modeled.","phase_available":"A","status":"modeled","variables":["sh_demand_kwh_th"],"provenance":"derived","source_ids":["M-001","DER-009","D-018"],"present_in":"all six buildings","docs":[],"inputs":["hp_sh_demand","tank_sh_demand"],"outputs":[]},{"id":"demand_hw","label":"Hot-water / base-load demand","category":"demand","description":"Derived warm-weather baseline of heat-pump heat (hot water and other use).","phase_available":"A","status":"modeled","variables":["hw_demand_kwh_th"],"provenance":"derived","source_ids":["M-001","A-005","D-014e"],"present_in":"all six buildings","docs":[],"inputs":["hp_hw_demand","tank_hw_demand"],"outputs":[]},{"id":"household","label":"Household electricity","category":"demand","description":"Non-heat-pump electricity. Metered for the houses (incl. electric water heaters of SFH-mid and SFH-high); synthetic for the apartment buildings.","phase_available":"A","status":"modeled","variables":["household_kwh_el"],"provenance":{"SFH":"measured","MFH":"synthetic"},"source_ids":["SRC-001","SRC-002","D-015"],"present_in":"all six buildings","docs":[],"inputs":["grid_household"],"outputs":[]},{"id":"district_outcomes","label":"District outcomes","category":"outcome","description":"Totals over the six buildings: electricity, peak demand, cost, and relative emissions.","phase_available":"A","status":"modeled","variables":["district.net_kwh_el","district.cost_chf"],"provenance":"modeled","source_ids":["R-001"],"present_in":"all six buildings","docs":[],"inputs":["grid_outcomes","tariff_outcomes","carbon_outcomes"],"outputs":[]},{"id":"pv","label":"Photovoltaics","category":"future","description